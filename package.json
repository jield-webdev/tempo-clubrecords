{
  "name": "tempo-clubrecords",
  "version": "1.0.0",
  "description": "Club records and auditable LENEX imports for Tempo Valkenswaard",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch --ignore \"node_modules/**\" src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/index.ts",
    "cli": "node --import tsx scripts/cli.ts",
    "db:seed": "node --import tsx scripts/cli.ts seed",
    "db:reset": "node --import tsx scripts/cli.ts reset",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" scripts tests docs README.md index.html vite.config.ts tsconfig.json package.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
