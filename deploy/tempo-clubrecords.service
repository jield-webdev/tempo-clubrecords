[Unit]
Description=Tempo clubrecords
After=network.target

[Service]
Type=simple
User=tempo
Group=tempo
WorkingDirectory=/opt/tempo-clubrecords
Environment=NODE_ENV=production
EnvironmentFile=/opt/tempo-clubrecords/.env
# Use the absolute path to your system-wide Node.js installation.
ExecStart=/usr/bin/node --import tsx src/server/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

StateDirectory=tempo-clubrecords
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tempo-clubrecords

[Install]
WantedBy=multi-user.target
