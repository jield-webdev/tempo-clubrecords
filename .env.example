HOST=127.0.0.1
PORT=3000
# SQLite is the default when DATABASE_URL is unset.
DATABASE_PATH=./data/tempo.sqlite
# Remote MySQL 8.0.23+: takes precedence over DATABASE_PATH.
# URL-encode special characters in username/password.
# DATABASE_URL=mysql://tempo:password@db.example.com:3306/tempo
# Azure MySQL: its public root CA bundle is included automatically for *.mysql.database.azure.com.
# DATABASE_URL=mysql://tempo:password@tempo.mysql.database.azure.com:3306/tempo
# MySQL uses TLS 1.2+ with certificate and hostname verification.
# Optional custom CA file (PEM bundle or a single DER .crt), overriding bundled Azure roots:
# DATABASE_SSL_CA=/etc/tempo/mysql-ca.pem
# Or provide PEM text in an Azure App Service setting (actual newlines or literal \n).
# Set only one of DATABASE_SSL_CA and DATABASE_SSL_CA_PEM.
# DATABASE_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Disable TLS only for non-Azure local development or a trusted private tunnel:
# DATABASE_SSL=false
# Set with: npm run cli -- admin:set-password
# Password hash and sessions are stored in the selected database; no default password.
# Set true when serving HTTPS behind Nginx; see docs/deployment.md.
COOKIE_SECURE=false
